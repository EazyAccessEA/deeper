---
import "../styles/global.css";
// Preloaded so the condensed display type is ready before first paint; a late swap re-wraps the headline (CLS).
import bricolage from "../assets/fonts/display.woff2?url";

import { createHash } from "node:crypto";
import { readFileSync } from "node:fs";

// Home only. Turns on the headline's insertion motion (html.m) once the display font is ready (html.go).
// If the font isn't ready in 400 ms, or motion is reduced, or this doesn't run, the page stays static.
// It sits first in <body>: after the stylesheets (so the @font-face rules exist; Astro puts them last in <head>)
// and before any content paints. Inline, so the CSP allows it by hash (public/_headers).
const MOTION = `(function(){var d=document.documentElement,f=document.fonts;if(!f||!matchMedia("(prefers-reduced-motion: no-preference)").matches)return;d.classList.add("m");function off(){d.classList.remove("m")}var t=setTimeout(off,400);f.load("condensed 800 1em Bricolage").then(function(a){clearTimeout(t);if(a.length&&d.classList.contains("m"))d.classList.add("go");else off()},off)})()`;
const motionHash = `'sha256-${createHash("sha256").update(MOTION).digest("base64")}'`;
if (!readFileSync("public/_headers", "utf8").includes(motionHash)) {
  throw new Error(`public/_headers: add ${motionHash} to script-src, or the motion script is blocked.`);
}

interface Props { title?: string; description?: string; }
const {
  title = "deeper: ask for the version an expert would ask for",
  description = "A free skill for AI agents. It rewrites a task with the method, sources and checks a top professional would use, then waits for your go-ahead.",
} = Astro.props;
const path = Astro.url.pathname;
// "Get started" rather than "Start": Lighthouse flags a bare "Start" link as non-descriptive.
const links = [["/start/", "Get started"], ["/journal/", "Journal"], ["/docs/", "Docs"], ["/patterns/", "Patterns"], ["/research/", "Research"]];
// deeper's own accounts. Add one only once it's open, its profile links back to deeper.tools/?ref=<platform>,
// and `curl` on the URL returns 200. They show in the footer (rel="me") and as sameAs in the structured data.
const socials: [string, string][] = [["https://bsky.app/profile/deeper.tools", "Bluesky"], ["https://www.youtube.com/@deeper-tools", "YouTube"], ["https://x.com/deepertools", "X (Twitter)"], ["https://www.tiktok.com/@deepertools", "TikTok"], ["https://www.instagram.com/deeper.tools/", "Instagram"], ["https://www.facebook.com/profile.php?id=61596409051860", "Facebook"]];
const og = new URL("/og.png", Astro.site).href;
const canonical = new URL(path, Astro.site).href;
// Structured data for search engines; a data block, so the CSP's script-src doesn't apply.
const software = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "deeper",
  description,
  url: "https://deeper.tools/",
  applicationCategory: "DeveloperApplication",
  operatingSystem: "Any",
  license: "https://www.apache.org/licenses/LICENSE-2.0",
  softwareVersion: "1.1.2",
  codeRepository: "https://github.com/EazyAccessEA/deeper",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  author: { "@type": "Organization", name: "Eazy Access Ltd", url: "https://github.com/EazyAccessEA" },
  ...(socials.length && { sameAs: socials.map(([href]) => href) }),
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="preload" href={bricolage} as="font" type="font/woff2" crossorigin />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={og} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={canonical} />
    <meta property="og:url" content={canonical} />
    {path === "/" && <script type="application/ld+json" set:html={JSON.stringify(software)} />}
  </head>
  <body>
    {path === "/" && <script is:inline set:html={MOTION} />}
    <a class="skip" href="#main">Skip to content</a>
    <div class="band-red top">
      <header class="wrap head">
        <a class="logo" href="/" aria-label="deeper, home"><img src="/wordmark-white.svg" alt="" width="104" height="35" /></a>
        <nav aria-label="Main">
          {links.map(([href, label], i) => <a href={href} class:list={{ extra: i > 1 }} aria-current={path === href ? "page" : undefined}>{label}</a>)}
          <a href="https://github.com/EazyAccessEA/deeper">GitHub</a>
        </nav>
      </header>
    </div>
    <main id="main"><slot /></main>
    <footer class="band-black foot">
      <div class="wrap foot-in">
        <div class="foot-mark">
          <img src="/wordmark-white.svg" alt="deeper" width="104" height="35" />
          <p>The four questions adapt a prompt from Felix Rieseberg's <a href="https://felixrieseberg.com/how-to-be-more-ambitious-a-tutorial-for-humans-with-models/">How to be more ambitious</a>.</p>
        </div>
        <nav aria-label="Footer">
          <div><h2>Product</h2><ul>{links.map(([href, label]) => <li><a href={href}>{label}</a></li>)}</ul></div>
          <div><h2>Project</h2><ul><li><a href="https://github.com/EazyAccessEA/deeper">GitHub</a></li><li><a href="/changelog/">Changelog</a></li><li><a href="https://github.com/EazyAccessEA/deeper/issues">Report an issue</a></li><li><a href="https://github.com/EazyAccessEA/deeper/blob/main/SECURITY.md">Security</a></li></ul></div>
          <div class="foot-connect"><h2>Connect</h2><ul><li><a href="mailto:hello@deeper.tools">hello@deeper.tools</a></li>{socials.map(([href, label]) => <li><a href={href} rel="me">{label}</a></li>)}</ul></div>
        </nav>
        <div class="foot-base">
          <p>© 2026 Eazy Access Ltd. Code under Apache 2.0.</p>
          <ul><li><a href="/privacy/">Privacy</a></li><li><a href="/legal/">Legal</a></li></ul>
        </div>
      </div>
    </footer>
  </body>
</html>

<style>
  .skip { position: absolute; left: -999px; }
  .skip:focus { left: 1rem; top: 1rem; background: var(--white); color: var(--black); padding: 0.5rem; z-index: 10; }
  /* Fixed height, one row at every width, so the header never reflows when fonts load. */
  .head { display: flex; align-items: center; justify-content: space-between; height: 5.25rem; }
  .logo { display: inline-flex; }
  .logo img { height: 2.1rem; width: auto; aspect-ratio: 104 / 35; }
  .head nav { display: flex; gap: 1.9rem; font-size: 1.0625rem; font-weight: 500; }
  .head nav a { display: inline-flex; align-items: center; min-height: 2.75rem; text-decoration: none; white-space: nowrap; }
  .head nav a:hover, .head nav a[aria-current="page"] { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 0.4em; }
  @media (max-width: 640px) {
    .head { height: 3.75rem; }
    .logo img { height: 1.75rem; }
    .head nav { gap: 1.1rem; font-size: 0.9375rem; }
    .head nav a.extra { display: none; }
  }

  .foot { padding-block: 4rem 4.5rem; font-size: 0.9375rem; line-height: 1.5; }
  /* Grid, not wrapping flex: wrapping left a column alone on its own row at some widths.
     Wide: mark on 6 of 12 columns, each link group on 2. Medium: mark above, groups 4 across.
     Below 768: Product and Project side by side, Connect full width with its links in the same two columns. */
  .foot-in { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); row-gap: 3rem; }
  .foot-mark { grid-column: 1 / 7; display: flex; flex-direction: column; gap: 1rem; max-width: 26rem; }
  .foot-mark img { height: 2.1rem; width: auto; align-self: flex-start; }
  .foot-mark p { color: var(--on-black); }
  .foot nav { grid-column: 7 / -1; display: grid; grid-template-columns: subgrid; row-gap: 2.5rem; }
  .foot nav > div { grid-column: span 2; }
  /* Medium weight, and no gap below: the label sits closer to its links than the links sit to each other. */
  .foot h2 { font: 500 0.9375rem/1.5 var(--sans); letter-spacing: 0; }
  .foot ul { list-style: none; margin: 0; padding: 0; }
  .foot li a { display: inline-flex; align-items: center; min-height: 2.25rem; color: var(--on-black); text-decoration: none; }
  .foot li a:hover { color: var(--white); text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 0.4em; }
  .foot-base { grid-column: 1 / -1; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; column-gap: 2rem; font-size: var(--t-sm); color: var(--on-black); }
  .foot-base ul { display: flex; gap: 1.5rem; }
  @media (max-width: 1199px) {
    .foot-mark { grid-column: 1 / -1; }
    .foot nav { grid-column: 1 / -1; }
    .foot nav > div { grid-column: span 4; }
  }
  @media (max-width: 767px) {
    .foot nav > div { grid-column: span 6; }
    .foot nav > .foot-connect { grid-column: 1 / -1; }
    .foot-connect ul { columns: 2; column-gap: var(--gutter); }
    .foot li a { min-height: 2.75rem; }
  }
</style>
