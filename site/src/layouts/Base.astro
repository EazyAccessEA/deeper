---
import "../styles/global.css";

interface Props { title?: string; description?: string; }
const {
  title = "deeper: ask for the version an expert would ask for",
  description = "A free skill for AI agents. It rewrites a task with the method, sources and checks a top professional would use, then waits for your go-ahead.",
} = Astro.props;
const path = Astro.url.pathname;
const links = [["/start/", "Start"], ["/docs/", "Docs"], ["/patterns/", "Patterns"], ["/research/", "Research"]];
const og = new URL("/og.png", Astro.site).href;
const canonical = new URL(path, Astro.site).href;
// Structured data for search engines; a data block, so the CSP's script-src doesn't apply.
const software = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "deeper",
  description,
  url: "https://deeper.tools/",
  applicationCategory: "DeveloperApplication",
  operatingSystem: "Any",
  license: "https://www.apache.org/licenses/LICENSE-2.0",
  softwareVersion: "1.1.0",
  codeRepository: "https://github.com/EazyAccessEA/deeper",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  author: { "@type": "Organization", name: "Eazy Access Ltd", url: "https://github.com/EazyAccessEA" },
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={og} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={canonical} />
    <meta property="og:url" content={canonical} />
    {path === "/" && <script type="application/ld+json" set:html={JSON.stringify(software)} />}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="wrap head">
      <a class="logo" href="/" aria-label="deeper, home">
        <img class="light" src="/wordmark.svg" alt="" width="104" height="35" />
        <img class="dark" src="/wordmark-dark.svg" alt="" width="104" height="35" />
      </a>
      <nav aria-label="Main">
        {links.map(([href, label]) => <a href={href} aria-current={path === href ? "page" : undefined}>{label}</a>)}
        <a href="https://github.com/EazyAccessEA/deeper">GitHub</a>
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="wrap foot">
      <img src="/favicon.svg" alt="" width="20" height="20" />
      <p class="muted">Apache 2.0. The four questions adapt a prompt from Felix Rieseberg's <a href="https://felixrieseberg.com/how-to-be-more-ambitious-a-tutorial-for-humans-with-models/">How to be more ambitious</a>.</p>
      <nav aria-label="Footer"><a href="mailto:hello@deeper.tools">hello@deeper.tools</a><a href="https://github.com/EazyAccessEA/deeper/issues">Report an issue</a><a href="https://github.com/EazyAccessEA/deeper/blob/main/SECURITY.md">Security</a><a href="/privacy/">Privacy</a><a href="/changelog/">Changelog</a><a href="/legal/">Legal</a><a href="https://github.com/EazyAccessEA/deeper">GitHub</a></nav>
    </footer>
  </body>
</html>

<style>
  .skip { position: absolute; left: -999px; }
  .skip:focus { left: 1rem; top: 1rem; background: var(--page); padding: 0.5rem; z-index: 10; }
  .head { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 5rem; flex-wrap: wrap; }
  .logo { display: inline-flex; padding: 0.5rem 0; }
  .logo img { height: 2.1rem; width: auto; }
  .dark { display: none; }
  @media (prefers-color-scheme: dark) { .light { display: none; } .dark { display: block; } }
  nav { display: flex; flex-wrap: wrap; }
  nav a { display: inline-flex; align-items: center; min-height: 2.75rem; padding: 0 0.7rem; text-decoration: none; color: var(--graphite); }
  nav a:hover, nav a[aria-current="page"] { color: var(--ink); }
  nav a[aria-current="page"] { text-decoration: underline; text-decoration-color: var(--red); text-decoration-thickness: 2px; }
  .head nav { margin-right: -0.7rem; }
  .foot { display: grid; grid-template-columns: auto 1fr auto; gap: 1rem; align-items: center; margin-top: var(--gap); padding-top: 2rem; padding-bottom: 3rem; border-top: 1px solid var(--rule); font-size: 0.95rem; }
  .foot p { max-width: var(--measure); }
  @media (max-width: 640px) { .foot { grid-template-columns: 1fr; } .foot img { display: none; } .foot nav { margin-left: -0.7rem; } }
</style>
