---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import Markup from "../components/Markup.astro";
import Copy from "../components/Copy.astro";
import { averages, wins, pairs } from "../lib/evidence";
import pencil from "../assets/pencil-tip.webp";

const questions = [
  ["Expert moves", "What would a top professional in this field do that you didn't ask for? One or two moves, not a list of tips."],
  ["Raw material", "What would they start from? The data, files and originals, not a summary of them. And one belief that material could disprove."],
  ["Instruments", "Which methods and tools would they use? A test, a measurement, a real canon, plus the skills and agents you already have."],
  ["Outside check", "What would show the result is right, other than you or the model? With a pass mark the best in the field would set."],
];
---
<Base>
  <section class="wrap hero">
    <div class="hero-copy">
      <h1>Ask for the version an expert would ask for.</h1>
      <p class="sub muted">deeper rewrites any task with the method, sources and checks a top professional would use. Same scope. You approve before it runs.</p>
      <Copy text="npx skills add EazyAccessEA/deeper" />
      <a class="see" href="#markup">See it mark up a real task</a>
    </div>
    <Image class="hero-img" src={pencil} alt="The tip of a red pencil touching white paper" widths={[480, 800, 1200]} sizes="(max-width: 900px) 100vw, 40vw" loading="eager" />
  </section>

  <section class="wrap block" id="markup">
    <h2>Your request, marked up.</h2>
    <Markup />
  </section>

  <section class="wrap block questions">
    <h2>Four questions before any rewrite.</h2>
    <ol>
      {questions.map(([q, a]) => (
        <li><h3>{q}</h3><p class="muted">{a}</p></li>
      ))}
    </ol>
    <p class="after">Then one prompt you can copy, and a question: run it? If a task is too small for depth to matter, it says so in one line and stops.</p>
  </section>

  <section class="wrap block evidence">
    <div class="ev-copy">
      <h2>{wins} of {pairs.length} blind pairs.</h2>
      <p class="muted">Five real tasks, rewritten with and without deeper, scored by a judge that didn't know which was which. Scope is the weak spot: on one task deeper added an A/B test nobody asked for.</p>
      <a href="/research">Every prompt, score and reason</a>
    </div>
    <table>
      <thead><tr><th scope="col">Out of 5</th><th scope="col">No skill</th><th scope="col">deeper</th></tr></thead>
      <tbody>
        {averages.map((a) => (
          <tr><th scope="row">{a.label}</th><td>{a.plain}</td><td class:list={{ up: Number(a.deeper) > Number(a.plain) }}>{a.deeper}</td></tr>
        ))}
      </tbody>
    </table>
  </section>

  <section class="wrap block install" id="install">
    <h2>Runs where you already work.</h2>
    <p class="muted">The command above puts deeper in Claude Code, Codex, Cursor and about seventy other agents. Prefer something else? There's a Claude Code plugin, a copy-by-hand route, and a way to paste it into ChatGPT or any chat app.</p>
    <a href="/docs#install">All install routes</a>
  </section>
</Base>

<style>
  .hero { display: grid; grid-template-columns: 7fr 5fr; gap: clamp(2rem, 5vw, 4rem); align-items: center; padding-top: clamp(2rem, 6vw, 5rem); }
  .hero > * { min-width: 0; }
  h1 { font-size: clamp(2.6rem, 5.4vw, 4.5rem); line-height: 1.04; max-width: 13em; }
  .sub { margin: 1.5rem 0 2rem; font-size: 1.2rem; max-width: 30em; }
  .see { display: inline-flex; align-items: center; min-height: 2.75rem; margin-top: 0.75rem; }
  .hero :global(.hero-img) { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: 40% 60%; border-radius: 4px; }

  @media (prefers-color-scheme: dark) { .hero :global(.hero-img) { filter: brightness(0.86); } }
  .block { padding-top: var(--gap); }
  .block > h2 { font-size: clamp(1.9rem, 3.6vw, 2.75rem); margin-bottom: 2.25rem; }

  .questions ol { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 2.5rem clamp(2rem, 6vw, 5rem); max-width: 60rem; }
  .questions li { padding-top: 1.25rem; border-top: 1px solid var(--rule); }
  .questions li:nth-child(even) { margin-top: 3rem; }
  .questions h3 { font-size: 1.3rem; margin-bottom: 0.5rem; }
  .after { margin-top: 3rem; max-width: var(--measure); }

  .evidence { display: grid; grid-template-columns: 5fr 7fr; gap: clamp(2rem, 6vw, 5rem); align-items: start; }
  .evidence > * { min-width: 0; }
  .ev-copy h2 { font-size: clamp(1.9rem, 3.6vw, 2.75rem); }
  .ev-copy p { margin: 1rem 0; max-width: 30em; }
  .ev-copy a { display: inline-flex; align-items: center; min-height: 2.75rem; }
  .evidence tbody th { font-weight: 400; }
  .evidence td { font-size: 1.15rem; font-weight: 500; width: 5.5rem; }
  .evidence td.up { color: var(--red); }
  .evidence tbody tr + tr { border-top: 1px solid var(--rule); }

  .install p { max-width: var(--measure); margin-bottom: 1rem; }
  .install a { display: inline-flex; align-items: center; min-height: 2.75rem; }

  @media (max-width: 900px) {
    .hero, .evidence { grid-template-columns: minmax(0, 1fr); }
    .hero :global(.hero-img) { aspect-ratio: 16 / 10; }
  }
  @media (max-width: 640px) {
    .questions ol { grid-template-columns: 1fr; }
    .questions li:nth-child(even) { margin-top: 0; }
  }
</style>
