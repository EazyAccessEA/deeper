---
// One page per Markdown file in src/content/journal/. Design: Paper, "deeper.tools — elevate", page "Journal".
import Base from "../../layouts/Base.astro";
import JournalFigure from "../../components/JournalFigure.astro";
import JournalTone from "../../components/JournalTone.astro";
import { figureHtml, hasImage } from "../../lib/figure";
import { blockHtml, reviewCards } from "../../lib/blocks";

export function getStaticPaths() {
  const files = import.meta.glob("../../content/journal/*.md", { eager: true });
  return Object.entries(files).map(([path, mod]: [string, any]) => ({
    params: { slug: path.split("/").pop()!.replace(".md", "") },
    props: { mod },
  }));
}

const { mod } = Astro.props as { mod: any };
const { title, description, date, minutes, sources = [], lead, figures = {}, dateline } = mod.frontmatter;
// Figures inside the text: <!-- figure:<key> --> in the Markdown, filled from `figures` in the front matter.
let body: string = await mod.compiledContent();
for (const [key, fig] of Object.entries(figures) as [string, any][]) {
  body = body.replace(`<!-- figure:${key} -->`, await figureHtml(fig));
}
// Blocks (charts, stat bands) from examples/raw: <!-- block:<key> -->. Review quotes become App Store cards.
body = reviewCards(body.replace(/<!-- block:([a-z-]+) -->/g, (_m, key) => blockHtml(key)));
// A dateline opens the article: one big figure and a short label, e.g. ["1974", "USA · model year"].
if (dateline) body = `<p class="jdateline"><span class="big">${dateline[0]}</span> <span class="jlabel">${dateline[1]}</span></p>` + body;
const sections = [...body.matchAll(/<h2 id="([^"]+)">(.*?)<\/h2>/g)].map(([, id, text]) => ({ id, text }));
const hasPhoto = Boolean(lead && hasImage(lead.file));
const nice = new Date(date).toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" });
const url = new URL(Astro.url.pathname, Astro.site).href;
const article = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description,
  datePublished: date,
  dateModified: date,
  url,
  mainEntityOfPage: url,
  image: new URL("/og.png", Astro.site).href,
  author: { "@type": "Organization", name: "Eazy Access Ltd", url: "https://deeper.tools/" },
  publisher: { "@type": "Organization", name: "Eazy Access Ltd", url: "https://deeper.tools/" },
};
---
<Base title={`${title} | deeper`} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(article)} />
  <JournalTone />
  <div class="jprogress" aria-hidden="true"></div>
  {/* With a lead photo, the photo fills the title band behind the text, under an ink overlay (see .jband.photo). */}
  <div class:list={["band-red jband", { photo: hasPhoto }]}>
    {hasPhoto && <div class="jhero"><JournalFigure {...lead} lead hero /></div>}
    <header class="wrap jtitle">
      <p class="meta"><a href="/journal/">Journal</a> · <time datetime={date}>{nice}</time> · {minutes} min read</p>
      <h1>{title}</h1>
      <p class="stand">{description}</p>
      <p class="disclaimer">Felix Rieseberg hasn't seen or endorsed deeper. We're not affiliated with him or Anthropic. deeper adapts the four questions from his post <a href="https://felixrieseberg.com/how-to-be-more-ambitious-a-tutorial-for-humans-with-models/">How to be more ambitious</a>.</p>
    </header>
  </div>
  <div class="wrap jbody">
    <aside class="margin" aria-label="About this article">
      <p class="label">Evidence</p>
      <p>Every figure comes from files in <a href="https://github.com/EazyAccessEA/deeper/tree/main/examples/raw">examples/raw</a>, recomputed by script.</p>
      <p class="label">Sources</p>
      <p><a href="#sources">{sources.length}, listed at the end</a></p>
      {sections.length > 2 && (
        <nav class="jtoc" aria-label="In this article">
          <p class="label">In this article</p>
          <ol>{sections.map((x) => <li><a href={`#${x.id}`} set:html={x.text} /></li>)}</ol>
        </nav>
      )}
    </aside>
    <article class="prose jprose">
      <Fragment set:html={body} />
      <section id="sources" class="sources" aria-label="Sources">
        <p class="label">Sources</p>
        <ol>{sources.map((s: { text: string; url: string }) => <li><a href={s.url}>{s.text}</a></li>)}</ol>
      </section>
    </article>
  </div>
</Base>

<script>
  // Marks the section being read in the margin contents: the last heading above the top third of the window.
  // Without JavaScript the list still works as links.
  const links = [...document.querySelectorAll<HTMLAnchorElement>(".jtoc a")];
  const heads = links.map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1))));
  let ticking = false;
  const mark = () => {
    ticking = false;
    let i = -1;
    heads.forEach((h, n) => { if (h && h.getBoundingClientRect().top < innerHeight * 0.3) i = n; });
    links.forEach((a, n) => (n === i ? a.setAttribute("aria-current", "true") : a.removeAttribute("aria-current")));
  };
  if (links.length) {
    addEventListener("scroll", () => { if (!ticking) { ticking = true; requestAnimationFrame(mark); } }, { passive: true });
    mark();
  }
</script>

<style>
  .jband { padding: clamp(2.5rem, 6vw, 6rem) 0 clamp(2.5rem, 5vw, 4.5rem); }
  /* Photo hero. The toned photo can be pure white in its light areas, so the overlay under the text is what keeps it
     readable: at 0.8 ink or more, white text is above 7:1 and the grey disclaimer above 4.5:1 even over pure white.
     Wide: the overlay is densest on the left, under the text, and thins out to the right so the photo shows.
     Narrow: the text runs the full width, so the overlay stays dense everywhere. */
  .jband.photo { position: relative; isolation: isolate; overflow: hidden; background: var(--black); color: var(--white);
    min-height: min(46rem, 88vh); display: flex; flex-direction: column; justify-content: flex-end; padding-top: clamp(6rem, 18vh, 12rem); }
  .jhero { position: absolute; inset: 0; z-index: -1; }
  .jhero :global(.jfig) { position: absolute; inset: 0; margin: 0; }
  .jhero :global(picture), .jhero :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; }
  .jhero :global(img) { object-fit: cover; object-position: 70% 50%; }
  /* --text-end: the right edge of the text column (46rem from the column's left edge, inside the centred wrap). */
  .jband.photo { --text-end: calc(max(0px, (100vw - var(--wrap)) / 2) + var(--gutter) + 46rem); }
  .jband.photo .jtitle h1 { max-width: 45rem; }
  /* The band is a flex column, and auto side margins would shrink the header to its text and centre it. */
  .jband.photo .jtitle { width: 100%; box-sizing: border-box; }
  .jhero :global(.jfig)::after { content: ""; position: absolute; inset: 0;
    background: linear-gradient(90deg, rgb(20 20 20 / 0.9) 0, rgb(20 20 20 / 0.8) var(--text-end), rgb(20 20 20 / 0.2) 100%); }
  .jhero :global(figcaption) { position: absolute; z-index: 1; right: var(--gutter); bottom: 1rem; max-width: 22rem; margin: 0; text-align: right;
    font-family: var(--mono); font-size: 0.75rem; line-height: 1.125rem; letter-spacing: 0.04em; text-transform: uppercase; color: var(--white); }
  .jhero :global(figcaption .cap) { color: inherit; padding: 0.25rem 0.5rem; background: rgb(20 20 20 / 0.82); }
  .jband.photo .disclaimer { color: var(--on-black); border-top-color: rgb(255 255 255 / 0.35); }
  @media (max-width: 899px) {
    /* --photo-h: the clear strip of photo above the text. The overlay reaches 0.8 just above where the text starts. */
    .jband.photo { --photo-h: clamp(5rem, 22vw, 8rem); min-height: 0; padding-top: var(--photo-h); padding-bottom: 2.5rem; }
    /* Shorter on phones so the article starts on the first screen: a smaller title and stand, tighter gaps. */
    .jband.photo .jtitle { gap: 1rem; }
    .jband.photo .jtitle h1 { font-size: clamp(2.375rem, 10.5vw, 3.3125rem); line-height: 1; }
    .jband.photo .stand { font-size: 1.0625rem; line-height: 1.5rem; }
    .jband.photo .disclaimer { font-size: 0.8125rem; line-height: 1.25rem; padding-top: 0.75rem; }
    .jhero :global(.jfig)::after { background: linear-gradient(180deg, rgb(20 20 20 / 0.3) 0, rgb(20 20 20 / 0.8) calc(var(--photo-h) - 1.5rem), rgb(20 20 20 / 0.9) 100%); }
    .jhero :global(figcaption) { left: var(--gutter); max-width: none; text-align: left; }
  }
  .jtitle { display: flex; flex-direction: column; gap: 1.5rem; }
  .jtitle > * { max-width: 45rem; }
  .meta, .label { font-family: var(--mono); font-size: 0.875rem; line-height: 1.25rem; letter-spacing: 0.04em; text-transform: uppercase; }
  .meta a { text-decoration: none; }
  .meta a:hover { text-decoration: underline; }
  .jtitle h1 { font-size: clamp(3.3125rem, 5.8vw, 5.1875rem); line-height: 0.96; max-width: 65rem; }
  .stand { font-size: 1.3125rem; line-height: 2rem; }
  .disclaimer { font-size: 0.875rem; line-height: 1.375rem; padding-top: 1rem; border-top: 1px solid rgb(255 255 255 / 0.5); }
  .jbody { display: flex; gap: 4rem; padding-top: clamp(2.5rem, 6vw, 6rem); padding-bottom: var(--band); }
  .margin { width: 15rem; flex-shrink: 0; font-size: 0.875rem; line-height: 1.375rem; padding-top: 0.375rem; }
  .margin .label { color: var(--grey); margin-top: 1.5rem; }
  .margin .label:first-child { margin-top: 0; }
  .margin p + p:not(.label) { margin-top: 0.25rem; }
  .jprose { max-width: 38.25rem; min-width: 0; }
  .jprose > :global(*) { max-width: none; }
  .label { color: var(--grey); }
  .sources { margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid currentColor; }
  .sources ol { margin: 0.75rem 0 0; padding-left: 1.5rem; font-size: 0.875rem; line-height: 1.375rem; }
  .sources li::marker { color: var(--red-text); font-family: var(--mono); }
  .sources li + li { margin-top: 0.75rem; }
  .jprose :global(h2) { font-size: clamp(2.125rem, 3vw, 2.625rem); line-height: 1; }
  .jprose :global(.jfig) { margin: 2rem 0 0; }
  .jprose > :global(.jfig:first-child) { margin: 0 0 2rem; }
  .jprose :global(.jfig img) { width: 100%; height: auto; display: block; background: var(--panel); }
  .jprose :global(.jfig figcaption) { margin-top: 0.75rem; font-size: 0.875rem; line-height: 1.375rem; color: var(--grey); }
  .jprose :global(.jfig .cap) { color: var(--ink); }
  .jprose :global(figure.run) { margin: 1.5rem 0 0; padding: 1.5rem; background: var(--panel); border-radius: 4px; }
  .jprose :global(figure.run figcaption) { font-family: var(--mono); font-size: 0.875rem; line-height: 1.25rem; color: var(--grey); }
  .jprose :global(figure.run blockquote) { margin: 0.75rem 0 0; }
  .jprose :global(figure.run p.note) { margin-top: 0.75rem; font-size: 0.875rem; line-height: 1.375rem; color: var(--grey); }
  .jprose :global(.pull) { margin: 2rem 0 0; padding: 1.5rem 0 0; border-top: 3px solid var(--red); }
  .jprose :global(.pull p) { font-weight: 800; font-stretch: 75%; font-size: clamp(2.125rem, 3vw, 2.625rem); line-height: 1.05; letter-spacing: -0.02em; text-wrap: balance; }
  .jprose :global(.pull cite) { display: block; margin-top: 0.75rem; font-style: normal; font-size: 0.875rem; color: var(--grey); }
  /* The border only shows in dark mode, where the black box would otherwise sit unseen on the dark ground. */
  .jprose :global(aside.limits) { margin-top: 2rem; padding: 2rem; background: var(--black); color: var(--white); border: 1px solid var(--rule); }
  @media (prefers-color-scheme: light) { .jprose :global(aside.limits) { border-color: var(--black); } }
  .jprose :global(aside.limits .label) { color: var(--on-black); }
  .jprose :global(aside.limits p + p) { margin-top: 0.75rem; }
  .jprose :global(.scores) { margin-top: 1.5rem; border-top: 1px solid currentColor; }
  .jprose :global(.scores th), .jprose :global(.scores td) { padding: 0.75rem 0; text-align: right; font-weight: 400; }
  .jprose :global(.scores th:first-child), .jprose :global(.scores td:first-child) { text-align: left; }
  .jprose :global(.scores thead th) { font-size: 0.875rem; color: var(--grey); border-bottom: 1px solid var(--rule); }
  .jprose :global(.scores td) { font-family: var(--mono); border-bottom: 1px solid var(--rule); }
  .jprose :global(.scores td:first-child) { font-family: var(--sans); }
  .jprose :global(.scores tr.mark td) { font-weight: 700; border-bottom-color: currentColor; }
  .jprose :global(.scores tr.mark td:first-child) { box-shadow: inset 4px 0 var(--red); padding-left: 0.75rem; }
  .jprose :global(.scores caption) { caption-side: bottom; text-align: left; padding-top: 0.75rem; font-size: 0.875rem; line-height: 1.375rem; color: var(--grey); }

  /* ---- Feature layer (Paper: "Journal — feature article"). The words are the Markdown's; these only change the pace. ---- */
  :global(main) { overflow-x: clip; }
  /* Reading progress: driven by scroll, no JavaScript. Browsers without scroll timelines simply don't show it. */
  .jprogress { position: fixed; inset: 0 0 auto 0; height: 3px; z-index: 50; background: var(--red); transform: scaleX(0); transform-origin: 0 50%; pointer-events: none; }
  @supports (animation-timeline: scroll()) { .jprogress { animation: jgrow linear both; animation-timeline: scroll(root); } }
  @keyframes jgrow { to { transform: scaleX(1); } }
  @keyframes jfill { from { transform: scaleX(0); } }

  /* Numbered sections. */
  .jprose { counter-reset: jsec; }
  .jprose :global(h2) { counter-increment: jsec; display: flex; align-items: baseline; gap: 0.75rem; margin-top: 3.5rem; padding-top: 1rem; border-top: 3px solid currentColor; }
  .jprose :global(h2)::before { content: counter(jsec, decimal-leading-zero); flex-shrink: 0; width: 1.75rem; font-size: 1.25rem; color: var(--red-text); }

  /* Contents in the margin, following the reader. */
  .jtoc { position: sticky; top: 1.5rem; margin-top: 2rem; }
  .jtoc ol { list-style: none; margin: 0.5rem 0 0; padding: 0; counter-reset: jt; }
  .jtoc li { counter-increment: jt; }
  .jtoc a { display: flex; gap: 0.5rem; padding: 0.3125rem 0; text-decoration: none; }
  .jtoc a::before { content: counter(jt, decimal-leading-zero); flex-shrink: 0; width: 1.5rem; color: var(--grey); }
  .jtoc a:hover { text-decoration: underline; }
  .jtoc a[aria-current] { color: var(--red-text); font-weight: 600; }
  .jtoc a[aria-current]::before { color: inherit; }

  .jprose :global(.jlabel) { font-family: var(--mono); font-size: 0.8125rem; line-height: 1.125rem; letter-spacing: 0.04em; text-transform: uppercase; color: var(--grey); }
  .jprose :global(.jnote) { margin-top: 0.75rem; font-size: 0.875rem; line-height: 1.25rem; color: var(--grey); }

  /* Dateline: one big figure opens the story, and the first paragraph reads as a lede. */
  .jprose :global(.jdateline) { display: flex; align-items: flex-end; flex-wrap: wrap; gap: 0.5rem 1rem; padding-bottom: 1.25rem; margin-bottom: 1.5rem; border-bottom: 3px solid currentColor; }
  .jprose :global(.jdateline .big) { font-weight: 800; font-stretch: 75%; font-size: clamp(6.5rem, 18vw, 10.5rem); line-height: 0.78; letter-spacing: -0.04em; color: var(--red-text); }
  .jprose :global(.jdateline .jlabel) { padding-bottom: 0.25rem; }
  .jprose :global(.jdateline + p) { font-size: clamp(1.3125rem, 2vw, 1.6875rem); line-height: 1.4; font-weight: 500; }

  /* Bar chart. */
  .jprose :global(.jchart) { margin: 2.5rem 0 0; }
  .jprose :global(.jchart ol) { list-style: none; margin: 0.875rem 0 0; padding: 0; display: flex; flex-direction: column; gap: 0.75rem; }
  .jprose :global(.jchart li) { display: grid; grid-template-columns: 1fr auto; row-gap: 0.25rem; column-gap: 1rem; font-size: 0.9375rem; line-height: 1.25rem; }
  .jprose :global(.jchart .val) { font-variant-numeric: tabular-nums; }
  .jprose :global(.jchart .bar) { grid-column: 1 / -1; height: 0.875rem; background: var(--panel); position: relative; }
  .jprose :global(.jchart .bar)::after { content: ""; position: absolute; inset: 0 auto 0 0; width: var(--w); background: var(--ink); transform-origin: 0 50%; }
  .jprose :global(.jchart .loud .lab), .jprose :global(.jchart .loud .val) { font-weight: 600; }
  .jprose :global(.jchart .loud .bar)::after { background: var(--red); }
  .jprose :global(.jchart .warned .bar)::after { background: var(--paper); box-shadow: inset 0 0 0 2px var(--red-text); }
  .jprose :global(.jchart .tag) { font-family: var(--mono); font-size: 0.6875rem; letter-spacing: 0.04em; text-transform: uppercase; color: var(--red-text); white-space: nowrap; }
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .jprose :global(.jchart .bar)::after { animation: jfill linear both; animation-timeline: view(); animation-range: entry 0% cover 30%; }
    }
  }

  /* Full-bleed bands inside the article: they leave the column and run the width of the window. */
  .jprose :global(.jstat), .jprose :global(.jgap) { margin: 3rem calc(-1 * var(--gutter)) 0; padding: 3rem var(--gutter) 3.25rem; position: relative; z-index: 2; }
  /* The bands pass over the sticky contents in the margin rather than under it. */
  .jprose :global(.jstat) { background: var(--red); color: var(--white); }
  .jprose :global(.jstat .jlabel) { color: var(--white); }
  .jprose :global(.jstat .big) { display: flex; align-items: baseline; flex-wrap: wrap; gap: 0.25rem 1rem; margin-top: 0.75rem; font-weight: 800; font-stretch: 75%; letter-spacing: -0.02em; }
  .jprose :global(.jstat .n) { font-size: clamp(8rem, 22vw, 15rem); line-height: 0.78; letter-spacing: -0.05em; }
  .jprose :global(.jstat .of) { font-size: clamp(2.25rem, 4.6vw, 4.125rem); line-height: 1; }
  .jprose :global(.jstat .say) { margin-top: 1rem; max-width: 26rem; font-size: clamp(1.0625rem, 1.5vw, 1.3125rem); line-height: 1.45; }
  .jprose :global(.jgap) { background: var(--black); color: var(--white); }
  .jprose :global(.jgap .head) { font-weight: 800; font-stretch: 75%; font-size: clamp(2.25rem, 5vw, 4.5rem); line-height: 0.95; letter-spacing: -0.02em; }
  .jprose :global(.jgap .cols) { display: flex; gap: 2rem 4rem; margin-top: 1.75rem; }
  .jprose :global(.jgap .cols > div) { flex: 1; min-width: 0; max-width: 26rem; }
  .jprose :global(.jgap .jlabel) { color: var(--on-black); padding-bottom: 0.5rem; border-bottom: 1px solid currentColor; }
  .jprose :global(.jgap .experts .jlabel), .jprose :global(.jgap .experts b) { color: #ff5a4e; }
  .jprose :global(.jgap ul) { list-style: none; margin: 0.5rem 0 0; padding: 0; }
  .jprose :global(.jgap li) { display: flex; justify-content: space-between; align-items: baseline; gap: 0.75rem; padding: 0.375rem 0; font-size: clamp(0.9375rem, 1.4vw, 1.3125rem); }
  .jprose :global(.jgap b) { font-weight: 800; font-stretch: 75%; font-size: clamp(1.375rem, 2.4vw, 2.125rem); white-space: nowrap; }
  .jprose :global(.jgap .jnote) { color: var(--on-black); }
  @media (min-width: 900px) {
    .jprose :global(.jstat), .jprose :global(.jgap) {
      --off: calc(max(0px, (100vw - var(--wrap)) / 2) + var(--gutter) + 19rem);
      width: 100vw; margin-left: calc(-1 * var(--off)); margin-right: 0; padding: 5rem var(--gutter) 5.5rem var(--off);
    }
  }

  /* App Store review cards. */
  .jprose :global(figure.run.review) { border-left: 4px solid var(--red); border-radius: 0 4px 4px 0; }
  .jprose :global(figure.run.review figcaption) { display: flex; align-items: center; gap: 0.75rem; font-family: var(--sans); }
  .jprose :global(.review .app) { flex-shrink: 0; display: grid; place-items: center; width: 2.25rem; height: 2.25rem; border-radius: 0.5625rem; background: var(--ink); color: var(--paper); font-weight: 700; font-size: 0.9375rem; }
  .jprose :global(.review .who) { display: flex; flex-wrap: wrap; align-items: baseline; column-gap: 0.5rem; font-size: 0.9375rem; line-height: 1.25rem; color: var(--grey); }
  .jprose :global(.review .who b) { color: var(--ink); font-weight: 600; }
  .jprose :global(.review .stars) { flex-basis: 100%; display: flex; gap: 2px; margin-top: 0.25rem; }
  .jprose :global(.review .stars span) { width: 0.875rem; height: 0.875rem; background: var(--rule);
    clip-path: polygon(50% 0, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%); }
  .jprose :global(.review .stars span.on) { background: var(--red-text); }
  .jprose :global(.review blockquote p) { font-weight: 800; font-stretch: 75%; font-size: clamp(1.75rem, 3vw, 2.125rem); line-height: 1.05; letter-spacing: -0.01em; }

  @media (max-width: 899px) {
    .jbody { flex-direction: column; gap: 1.5rem; }
    .margin { width: auto; }
    .margin .label { display: inline; margin: 0; }
    .margin .label:not(:first-child) { display: none; }
    .margin p:nth-child(4) { display: none; }
    .jtoc { display: none; }
  }
  @media (max-width: 599px) { .jprose :global(.jgap .cols) { flex-direction: column; } }
  /* Phone: each version becomes a row with its figures beneath, labelled from the header (data-label). */
  @media (max-width: 599px) {
    .jprose :global(.scores thead) { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
    .jprose :global(.scores tr) { display: grid; grid-template-columns: repeat(4, 1fr); padding: 0.75rem 0 0.75rem 1rem; border-bottom: 1px solid var(--rule); }
    .jprose :global(.scores td) { border: 0; padding: 0; text-align: left; }
    .jprose :global(.scores td:first-child) { grid-column: 1 / -1; margin-bottom: 0.5rem; }
    .jprose :global(.scores td:not(:first-child)::before) { content: attr(data-label); display: block; font-family: var(--sans); font-size: 0.875rem; color: var(--grey); font-weight: 400; }
    .jprose :global(.scores tr.mark) { box-shadow: inset 4px 0 var(--red); }
    .jprose :global(.scores tr.mark td:first-child) { box-shadow: none; padding-left: 0; }
  }
</style>
