---
import { pairs } from "../lib/evidence";
---
<div class="demo" data-demo>
  <div class="tabs" role="tablist" aria-label="Example tasks">
    {pairs.map((p, i) => (
      <button role="tab" id={`tab-${p.id}`} aria-controls={`panel-${p.id}`} aria-selected={i === 1 ? "true" : "false"} tabindex={i === 1 ? 0 : -1}>
        {p.short}
      </button>
    ))}
  </div>
  {pairs.map((p, i) => (
    <section class="panel" role="tabpanel" id={`panel-${p.id}`} aria-labelledby={`tab-${p.id}`} hidden={i !== 1} data-show="deeper">
      <p class="task"><span class="muted">Task</span> {p.task}</p>
      <div class="toggle" role="group" aria-label="Which rewrite to show">
        <button data-pick="plain" aria-pressed="false">Plain rewrite</button>
        <button data-pick="deeper" aria-pressed="true">/deeper</button>
      </div>
      <div class="cols">
        <article class="col plain">
          <h3>Plain rewrite</h3>
          <pre>{p.plain}</pre>
          <p class="foot">{p.winner === "baseline" ? "Won the blind test" : "Lost the blind test"}</p>
        </article>
        <article class="col deep">
          <h3>/deeper</h3>
          <pre>{p.deeper}</pre>
          <p class:list={["foot", { won: p.winner === "deeper" }]}>{p.winner === "deeper" ? "Won the blind test" : "Lost the blind test"}</p>
        </article>
      </div>
      <p class="verdict"><strong>Blind judge:</strong> {p.winner === "deeper" ? "/deeper won." : p.winner === "tie" ? "Tie." : "The plain rewrite won."} {p.reason}</p>
    </section>
  ))}
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-demo]").forEach((demo) => {
    const tabs = [...demo.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const select = (tab: HTMLButtonElement) => {
      tabs.forEach((t) => {
        const on = t === tab;
        t.setAttribute("aria-selected", String(on));
        t.tabIndex = on ? 0 : -1;
        demo.querySelector<HTMLElement>(`#${t.getAttribute("aria-controls")}`)!.hidden = !on;
      });
    };
    tabs.forEach((t, i) => {
      t.addEventListener("click", () => select(t));
      t.addEventListener("keydown", (e) => {
        const d = e.key === "ArrowRight" ? 1 : e.key === "ArrowLeft" ? -1 : 0;
        if (!d) return;
        const next = tabs[(i + d + tabs.length) % tabs.length];
        select(next);
        next.focus();
      });
    });
    demo.querySelectorAll<HTMLButtonElement>("[data-pick]").forEach((b) => {
      b.addEventListener("click", () => {
        const panel = b.closest<HTMLElement>(".panel")!;
        panel.dataset.show = b.dataset.pick;
        panel.querySelectorAll("[data-pick]").forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
      });
    });
  });
</script>

<style>
  .tabs { display: flex; gap: 0; overflow-x: auto; border-bottom: 1px solid var(--line); scrollbar-width: none; }
  [role="tab"] {
    flex: none; min-height: 2.75rem; padding: 0 1rem; background: none; border: 0;
    font: 500 0.95rem var(--sans); color: var(--ink-2); cursor: pointer; white-space: nowrap;
  }
  [role="tab"][aria-selected="true"] { color: var(--ink); box-shadow: inset 0 -2px var(--accent); }
  .task { margin: 1.5rem 0 1rem; font-size: 1.05rem; max-width: var(--measure); }
  .task .muted { font: 500 0.8rem var(--mono); margin-right: 0.5rem; }
  .cols { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; background: var(--line); border: 1px solid var(--line); }
  .col { background: var(--paper); padding: 1.25rem; min-width: 0; }
  .col.deep { background: var(--paper-2); }
  .col h3 { font: 500 0.8rem var(--mono); color: var(--ink-2); margin-bottom: 0.75rem; }
  .col.deep h3 { color: var(--accent); }
  pre {
    margin: 0; white-space: pre-wrap; overflow-wrap: anywhere; font-size: 0.82rem; line-height: 1.55;
    max-height: 30rem; overflow-y: auto;
  }
  .foot { margin-top: 1rem; padding-top: 0.75rem; border-top: 1px solid var(--line); font-size: 0.85rem; color: var(--ink-2); }
  .foot.won { color: var(--accent); font-weight: 500; }
  .verdict { margin-top: 1rem; font-size: 0.95rem; color: var(--ink-2); max-width: var(--measure); }
  .verdict strong { color: var(--ink); font-weight: 500; }
  .toggle { display: none; }
  @media (max-width: 767px) {
    .toggle { display: inline-flex; border: 1px solid var(--line); margin-bottom: 0.75rem; }
    .toggle button { min-height: 2.75rem; padding: 0 1rem; border: 0; background: none; font: 500 0.9rem var(--sans); color: var(--ink-2); cursor: pointer; }
    .toggle button[aria-pressed="true"] { background: var(--ink); color: var(--paper); }
    .cols { grid-template-columns: 1fr; }
    .panel[data-show="deeper"] .plain, .panel[data-show="plain"] .deep { display: none; }
  }
</style>
