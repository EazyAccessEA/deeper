---
// The journal's photo treatment: a three-tone map in the site palette. Dark areas become ink, middle tones Proof Red,
// light areas the page colour. Applied in the browser (CSS filter), so the licensed files are never altered.
// Values: ink #141414, red #D0241B, white #FFFFFF; in dark mode #121212, red, #EDEDED.
const light = { r: "0.078 0.816 1", g: "0.078 0.141 1", b: "0.078 0.106 1" };
const dark = { r: "0.071 0.816 0.929", g: "0.071 0.141 0.929", b: "0.071 0.106 0.929" };
---
<svg class="jtone-defs" width="0" height="0" aria-hidden="true" focusable="false">
  {[["jtone-light", light], ["jtone-dark", dark]].map(([id, t]: any) => (
    <filter id={id} color-interpolation-filters="sRGB">
      <feColorMatrix type="matrix" values="0.2126 0.7152 0.0722 0 0  0.2126 0.7152 0.0722 0 0  0.2126 0.7152 0.0722 0 0  0 0 0 1 0" />
      <feComponentTransfer>
        <feFuncR type="table" tableValues={t.r} />
        <feFuncG type="table" tableValues={t.g} />
        <feFuncB type="table" tableValues={t.b} />
      </feComponentTransfer>
    </filter>
  ))}
</svg>

<style is:global>
  .jtone-defs { position: absolute; width: 0; height: 0; overflow: hidden; }
  .jfig img { filter: url(#jtone-light); }
  @media (prefers-color-scheme: dark) { .jfig img { filter: url(#jtone-dark); } }
</style>
