---
// A plain form post to worker.js. The page URL's ?ref= travels in the Referer header, so the signup records its source.
---
<form class="subscribe" method="post" action="/api/subscribe">
  <label for="email">Email</label>
  <div class="row">
    <input id="email" name="email" type="email" required maxlength="254" autocomplete="email" placeholder="you@example.com" />
    <button type="submit">Get updates</button>
  </div>
  <input class="trap" name="company" tabindex="-1" autocomplete="off" aria-hidden="true" />
  <p class="muted fine">One email per new version or new test. Unsubscribe from any of them. We keep the address, the date, your country and the link you came from, plus a one-way hash of your IP that stops repeat signups. <a href="/privacy/">Privacy notice</a>.</p>
</form>

<style>
  .subscribe { max-width: 32rem; }
  label { display: block; font-weight: 600; margin-bottom: 0.4rem; }
  .row { display: flex; gap: 0.5rem; }
  input[type="email"] {
    flex: 1; min-width: 0; min-height: 3.25rem; padding: 0 1rem; border: 1px solid var(--rule); border-radius: 4px;
    background: var(--white); color: var(--black); font: inherit;
  }
  input[type="email"]::placeholder { color: #6b6f76; }
  button {
    flex: none; min-height: 3.25rem; padding: 0 1.4rem; border: 0; border-radius: 4px; cursor: pointer;
    background: var(--black); color: var(--white); font: 700 1rem var(--sans);
  }
  :global(.band-red) input[type="email"] { border-color: var(--white); }
  .trap { position: absolute; left: -9999px; width: 1px; height: 1px; }
  .fine { margin-top: 0.75rem; font-size: 0.875rem; line-height: 1.5; }
  @media (max-width: 400px) { .row { flex-direction: column; } }
</style>
