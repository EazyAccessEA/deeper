---
interface Props { text: string; }
const { text } = Astro.props;
---
<div class="copy">
  <code>{text}</code>
  <button type="button" data-copy={text} aria-label={`Copy: ${text}`}>Copy</button>
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((b) => {
    b.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(b.dataset.copy!);
        b.textContent = "Copied";
      } catch {
        b.textContent = "Select and copy";
      }
      setTimeout(() => (b.textContent = "Copy"), 1800);
    });
  });
</script>

<style>
  .copy { display: flex; align-items: center; gap: 0.5rem; min-width: 0; max-width: 30rem; background: var(--margin); border-radius: 4px; padding: 0.4rem 0.4rem 0.4rem 1rem; }
  code { flex: 1; min-width: 0; overflow-x: auto; white-space: nowrap; font-size: 0.92rem; }
  button {
    flex: none; min-height: 2.75rem; padding: 0 1.1rem; border: 0; border-radius: 4px; cursor: pointer;
    background: var(--red); color: var(--on-red); font: 600 0.95rem var(--sans);
    transition: transform 0.12s;
  }
  button:active { transform: translateY(1px); }
  @media (max-width: 480px) { code { white-space: normal; overflow-wrap: anywhere; font-size: 0.85rem; } }
</style>
