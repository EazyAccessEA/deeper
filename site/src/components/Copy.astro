---
interface Props { text: string; label?: string; }
const { text, label = "Copy" } = Astro.props;
---
<div class="copy">
  <code>{text}</code>
  <button type="button" data-copy={text} data-label={label} aria-label={`${label}: ${text}`}><span class="long">{label}</span><span class="short">Copy</span></button>
  <span class="sr" role="status" aria-live="polite"></span>
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((b) => {
    const status = b.parentElement!.querySelector<HTMLElement>('[role="status"]')!;
    const parts = [...b.querySelectorAll("span")];
    // The new label fades in (200 ms, opacity only, so it stays under reduced motion too).
    const say = (t: string) => { parts.forEach((p) => { p.textContent = t; p.animate?.([{ opacity: 0 }, { opacity: 1 }], { duration: 200, easing: "ease-out" }); }); status.textContent = t; };
    b.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(b.dataset.copy!);
        say("Copied");
      } catch {
        say("Select and copy");
      }
      setTimeout(() => { parts[0].textContent = b.dataset.label!; parts[1].textContent = "Copy"; status.textContent = ""; }, 1800);
    });
  });
</script>

<style>
  /* On white: grey panel, red button. On a red band: white panel, black button. */
  .copy { display: flex; align-items: center; gap: 0.5rem; min-width: 0; max-width: 34rem; background: var(--panel); border-radius: 4px; padding: 0.5rem 0.5rem 0.5rem 1.25rem; min-height: 4rem; }
  code { flex: 1; min-width: 0; overflow-x: auto; white-space: nowrap; font-size: 0.9375rem; color: var(--ink); }
  button {
    flex: none; min-height: 3rem; padding: 0 1.4rem; border: 0; border-radius: 3px; cursor: pointer;
    background: var(--red); color: var(--white); font: 700 1rem var(--sans);
  }
  @media (prefers-reduced-motion: no-preference) {
    button { transition: transform 140ms cubic-bezier(0.23, 1, 0.32, 1); }
    button:active { transform: scale(0.97); }
  }
  :global(.band-red) .copy { background: var(--white); }
  :global(.band-red) code { color: var(--black); }
  :global(.band-red) button { background: var(--black); }
  .long { display: none; }
  @media (max-width: 560px) {
    .copy { flex-direction: column; align-items: stretch; background: none; padding: 0; gap: 0.5rem; }
    :global(.band-red) .copy { background: none; }
    code { background: var(--panel); border-radius: 4px; padding: 0.95rem 0.9rem; font-size: 0.8125rem; }
    :global(.band-red) code { background: var(--white); }
    button { min-height: 3rem; font-size: 1rem; }
    .long { display: inline; }
    .short { display: none; }
  }
</style>
