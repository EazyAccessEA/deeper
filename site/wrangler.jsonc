// Cloudflare serves the built files in dist/; worker.js answers /api/* only. Deploy with `npm run build && npx wrangler deploy`.
// The email list is D1 "deeper-list" (schema.sql); the IP salt is the IP_SALT secret.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "deeper",
  "main": "worker.js",
  "compatibility_date": "2026-10-19",
  "routes": [{ "pattern": "deeper.tools", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Pages run through the Worker so it can add /count.js; keep this list in step with PAGES in worker.js.
    "run_worker_first": ["/api/*", "/", "/start/", "/docs/", "/patterns/", "/research/", "/changelog/", "/privacy/", "/legal/", "/subscribed/"]
  },
  "triggers": { "crons": ["17 3 * * *"] },
  "d1_databases": [{ "binding": "DB", "database_name": "deeper-list", "database_id": "07f27d29-5336-45a2-a90f-fc2322a068b4" }]
}
