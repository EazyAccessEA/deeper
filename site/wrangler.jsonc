// Cloudflare serves the built files in dist/; worker.js answers /api/* only. Deploy with `npm run build && npx wrangler deploy`.
// Before the first deploy: `npx wrangler d1 create deeper-list`, paste its id below, apply schema.sql with --remote,
// and set the salt with `npx wrangler secret put IP_SALT`. The placeholder id makes a deploy fail until then.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "deeper",
  "main": "worker.js",
  "compatibility_date": "2026-10-19",
  "routes": [{ "pattern": "deeper.tools", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "triggers": { "crons": ["17 3 * * *"] },
  "d1_databases": [{ "binding": "DB", "database_name": "deeper-list", "database_id": "00000000-0000-0000-0000-000000000000" }]
}
