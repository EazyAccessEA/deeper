// Static site: Cloudflare serves the built files in dist/. Deploy with `npm run build && npx wrangler deploy`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "deeper",
  "compatibility_date": "2026-11-02",
  "routes": [{ "pattern": "deeper.tools", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
